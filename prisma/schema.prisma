// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// money moving out of Jirani: the owner payout and the borrower refund
enum TransferStatus {
  NONE
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            Int    @id @default(autoincrement())
  name          String
  phone         String
  // Paystack transfer recipient for the number the owner registered with
  recipientCode  String?
  recipientPhone String?
  email         String  @unique
  password      String 
  isAdmin       Boolean @default(false)
  canList       Boolean @default(false)
  canBorrow     Boolean @default(true)
  items Item[]
  bookings Booking[]
}

model Item {
  id          Int     @id @default(autoincrement())
  ownerId     Int    
  owner       User    @relation(fields: [ownerId], references: [id]) 
  title       String
  description String
  dailyRate   Int     @default(0)
  deletedAt   DateTime?
  images      ItemImage[]
  bookings    Booking[]
}

model ItemImage {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}


model Booking {
  id              Int           @id @default(autoincrement())
  itemId          Int
  borrowerId      Int
  borrower        User      @relation(fields: [borrowerId], references:[id])
  item            Item       @relation(fields: [itemId], references: [id])
  status          BookingStatus @default(PENDING)
  startDate       DateTime      @db.Date   
  endDate         DateTime      @db.Date   
  dailyRate       Int                      
  returnedAt      DateTime?  
  decisionNote    String?          
  // when the owner approved; an unpaid booking expires a set time after this
  approvedAt      DateTime?
  payment         Payment?

}

// One payment per booking. Collection, owner payout and refund are tracked on the same row.
model Payment {
  id             Int            @id @default(autoincrement())
  bookingId      Int            @unique
  booking        Booking        @relation(fields: [bookingId], references: [id])
  amount         Int            // KES, whole shillings
  reference      String         @unique   // sent to Paystack, changes on every new attempt
  status         PaymentStatus  @default(PENDING)
  paidAt         DateTime?
  channel        String?

  payoutStatus    TransferStatus @default(NONE)
  payoutReference String?        @unique
  payoutNote      String?
  paidOutAt       DateTime?

  refundStatus   TransferStatus @default(NONE)
  refundNote     String?
  refundedAt     DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
